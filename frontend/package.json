{
  "name": "endorphins-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "start": "bun run server.ts",
    "typegen": "bun --bun tsr generate && bun --bun openapi-typescript ../api/openapi.json -o app/types/api.gen.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings app test scripts server.ts vite.config.ts && bun scripts/check-boundaries.ts && bun run doctor",
    "doctor": "react-doctor . --scope full --blocking warning --no-score --no-supply-chain",
    "test": "bun test test",
    "format": "prettier --write app server.ts vite.config.ts test scripts",
    "format:check": "prettier --check app server.ts vite.config.ts test scripts"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "1.6.3",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.59",
    "lucide-react": "1.49.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.39",
    "@types/bun": "1.4.2",
    "@types/node": "24.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.86.0",
    "prettier": "3.6.2",
    "react-doctor": "0.9.17",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
