# Optional overrides; export these in your shell before running make dev.
# API_ADDRESS=127.0.0.1:8088
# EXERCISE_DIR=/absolute/path/to/endorphins/exercises
# API_ORIGIN=http://127.0.0.1:8088
# PORT=3100
# HOST=127.0.0.1

# Authentication and Postgres (development)
# Run `clerk auth login`, then from frontend:
# clerk init --app app_3K5z4w8PFdIMSXl1sR7bXIDV6EV
# Let the CLI write VITE_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY to
# frontend/.env.local. Never add CLERK_SECRET_KEY to VITE_* variables.
# make dev / make api / make migrate forward that environment to Go via Bun.
DATABASE_URL=postgres://endorphins:endorphins_local@127.0.0.1:5548/endorphins?sslmode=disable
APP_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# Clerk user.deleted webhook (separate from CLERK_SECRET_KEY).
# Required with a pk_live_ publishable key; configure the provider endpoint at
# https://YOUR_APP_ORIGIN/api/webhooks/clerk and subscribe to user.deleted.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
