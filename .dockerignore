# Only application sources enter the image build context. Do not re-include a whole
# folder such as `!frontend/`: it also brings host node_modules, .env files and build
# output, and `COPY frontend .` then overwrites the image's own install.
**
!backend/go.mod
!backend/go.sum
!backend/Dockerfile
!backend/cmd/**
!backend/internal/**
!exercises/**
!frontend/package.json
!frontend/bun.lock
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/tsr.config.json
!frontend/server.ts
!frontend/Dockerfile
!frontend/scripts/check-release.ts
!frontend/app/**
!frontend/public/**
!frontend/test/identity/**
