+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestCommandHelpNeedsNoCredentialsOrDatabase(t *testing.T) {
+	for _, name := range []string{"DATABASE_URL", "CLERK_SECRET_KEY", "VITE_CLERK_PUBLISHABLE_KEY", "GO_FLAGS_COMPLETION"} {
+		t.Setenv(name, "")
+	}
+	t.Setenv("API_ADDRESS", "invalid")
+	var stdout, stderr bytes.Buffer
+	code := run(t.Context(), []string{"--help"}, &stdout, &stderr)
+	if code != 0 || stderr.Len() != 0 || !strings.Contains(stdout.String(), "Usage:") || !strings.Contains(stdout.String(), "Clerk:") {
+		t.Fatalf("help exit=%d stdout=%s stderr=%s", code, &stdout, &stderr)
+	}
+}
+
+func TestCommandRejectsArgumentsWithoutExposingSecrets(t *testing.T) {
+	t.Setenv("GO_FLAGS_COMPLETION", "")
+	var stdout, stderr bytes.Buffer
+	code := run(t.Context(), []string{"--unknown=secret-value"}, &stdout, &stderr)
+	if code != 2 || stdout.Len() != 0 || strings.Contains(stderr.String(), "secret-value") || !strings.Contains(stderr.String(), "configuration failed") {
+		t.Fatalf("unsafe usage exit/output: %d", code)
+	}
+}
