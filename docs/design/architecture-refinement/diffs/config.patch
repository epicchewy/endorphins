+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestCommandHelpDoesNotOpenDatabase(t *testing.T) {
+	t.Setenv("DATABASE_URL", "invalid-private-connection-string")
+	t.Setenv("GO_FLAGS_COMPLETION", "")
+	var stdout, stderr bytes.Buffer
+	code := run([]string{"--help"}, &stdout, &stderr)
+	if code != 0 || stderr.Len() != 0 || !strings.Contains(stdout.String(), "Postgres:") || strings.Contains(stdout.String(), "Clerk") || strings.Contains(stdout.String(), "invalid-private") {
+		t.Fatalf("help exit=%d stdout=%s stderr=%s", code, &stdout, &stderr)
+	}
+}
+
+func TestCommandValidatesBeforeMigration(t *testing.T) {
+	t.Setenv("GO_FLAGS_COMPLETION", "")
+	var stdout, stderr bytes.Buffer
+	code := run([]string{"--database-url=private-connection-string"}, &stdout, &stderr)
+	if code != 2 || stdout.Len() != 0 || strings.Contains(stderr.String(), "private-connection-string") || !strings.Contains(stderr.String(), "configuration failed") {
+		t.Fatalf("unsafe validation exit/output: %d", code)
+	}
+}
