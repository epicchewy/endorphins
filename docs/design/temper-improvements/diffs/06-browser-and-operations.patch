+import { spawn, type ChildProcess } from 'node:child_process'
+import assert from 'node:assert/strict'
+import { mkdtemp, readFile, rm, symlink, copyFile, open, mkdir } from 'node:fs/promises'
+import { createServer } from 'node:net'
+import { tmpdir } from 'node:os'
+import { dirname, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..')
+
+async function freePort() {
+  const server = createServer()
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const address = server.address()
+  if (!address || typeof address === 'string') throw new Error('No local port')
+  await new Promise<void>((resolve, reject) =>
+    server.close((error) => (error ? reject(error) : resolve())),
+  )
+  return address.port
+}
+
+export default async function setup() {
+  const scratch = await mkdtemp(resolve(tmpdir(), 'endorphins-e2e-'))
+  const artifactDir = resolve(root, 'output/playwright')
+  await mkdir(artifactDir, { recursive: true })
+  const logs = await open(resolve(artifactDir, 'stack.log'), 'w')
+  const processes: ChildProcess[] = []
+  const env = { ...process.env, GOTOOLCHAIN: 'go1.27.1' }
+  const start = (cmd: string, args: string[], cwd: string, extra = {}) => {
+    const child = spawn(cmd, args, {
+      cwd,
+      env: { ...env, ...extra },
+      stdio: ['ignore', logs.fd, logs.fd],
+    })
+    processes.push(child)
+    return child
+  }
+  const run = async (cmd: string, args: string[], cwd: string, extra = {}) => {
+    const child = start(cmd, args, cwd, extra)
+    await new Promise<void>((resolve, reject) => {
+      child.once('error', reject)
+      child.once('exit', (code) =>
+        code === 0
+          ? resolve()
+          : reject(new Error(`${cmd} ${args.join(' ')} failed; see output/playwright/stack.log`)),
+      )
+    })
+  }
+  const terminate = async (child: ChildProcess) => {
+    if (child.exitCode !== null || child.signalCode !== null) return
+    await new Promise<void>((resolve) => {
+      const timeout = setTimeout(() => {
+        child.kill('SIGKILL')
+        resolve()
+      }, 15_000)
+      child.once('exit', () => {
+        clearTimeout(timeout)
+        resolve()
+      })
+      child.kill('SIGTERM')
+    })
+  }
+  const stop = async () => {
+    for (const child of processes.reverse()) await terminate(child)
+    await logs.close()
+    await rm(scratch, { recursive: true, force: true })
+  }
+  try {
+    const baseURL = `http://127.0.0.1:${await freePort()}`
+    const metadata = resolve(scratch, 'fixture.json')
+    await run(
+      'go',
+      ['build', '-tags', 'integration', '-o', resolve(scratch, 'fixture'), './cmd/smokefixture'],
+      resolve(root, 'backend'),
+    )
+    const fixture = start(resolve(scratch, 'fixture'), [metadata], root, {
+      E2E_FRONTEND_ORIGIN: baseURL,
+      EXERCISE_DIR: resolve(root, 'exercises'),
+    })
+    let apiOrigin: string | undefined
+    for (let attempt = 0; attempt < 150; attempt++) {
+      if (fixture.exitCode !== null)
+        throw new Error('API fixture exited; see output/playwright/stack.log')
+      try {
+        apiOrigin = JSON.parse(await readFile(metadata, 'utf8')).apiOrigin
+        if (apiOrigin) break
+      } catch {
+        /* Starts after migration and signing-key setup. */
+      }
+      await new Promise((resolve) => setTimeout(resolve, 200))
+    }
+    if (!apiOrigin) throw new Error('API fixture startup timed out')
+    await run('bun', ['run', 'build', '--mode', 'e2e'], resolve(root, 'frontend'), {
+      VITE_CLERK_PUBLISHABLE_KEY: 'pk_test_c21va2UuY2xlcmsuYWNjb3VudHMuZGV2JA',
+      CLERK_SECRET_KEY: '',
+    })
+    // Run the same production SSR/static/proxy entry against the isolated test build.
+    await copyFile(resolve(root, 'frontend/server.ts'), resolve(scratch, 'server.ts'))
+    await symlink(resolve(root, 'frontend/build-e2e'), resolve(scratch, 'build'), 'dir')
+    await symlink(resolve(root, 'frontend/node_modules'), resolve(scratch, 'node_modules'), 'dir')
+    start('bun', ['run', resolve(scratch, 'server.ts')], scratch, {
+      API_ORIGIN: apiOrigin,
+      HOST: '127.0.0.1',
+      PORT: new URL(baseURL).port,
+    })
+    for (let attempt = 0; attempt < 100; attempt++) {
+      try {
+        if ((await fetch(baseURL, { signal: AbortSignal.timeout(2_000) })).ok) break
+      } catch {
+        /* Wait for SSR readiness. */
+      }
+      if (attempt === 99) throw new Error('Frontend startup timed out')
+      await new Promise((resolve) => setTimeout(resolve, 100))
+    }
+    process.env.PLAYWRIGHT_TEST_BASE_URL = baseURL
+    process.env.ENDORPHINS_E2E_API_ORIGIN = apiOrigin
+    return async () => {
+      try {
+        // Exercise an actual upstream outage, without mocking fetch or stopping another test's API.
+        await terminate(fixture)
+        const response = await fetch(`${baseURL}/api/v1/workouts`, {
+          signal: AbortSignal.timeout(5_000),
+        })
+        assert.equal(response.status, 503)
+        const error = await response.json()
+        assert.equal(error.code, 'service_unavailable')
+        assert.equal(error.requestId, response.headers.get('x-request-id'))
+        assert.equal(response.headers.get('cache-control'), 'no-store')
+      } finally {
+        await stop()
+      }
+    }
+  } catch (error) {
+    await stop()
+    throw error
+  }
+}
